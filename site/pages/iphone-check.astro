<script is:inline>
const TOTAL = 29;
const state = {};
const CRITICAL = {
  'chk-activation-lock': 'قفل iCloud مفعل — الجهاز غير صالح للاستخدام',
  'chk-stolen':          'IMEI محجوب أو مسروق — لا تشتري',
  'chk-imei-apple':      'مشكلة في سجل Apple — تحقق قبل الشراء',
  'chk-water':           'تلف مياه — الجهاز قد يموت في أي وقت',
  'chk-faceid-genuine':  'Face ID / Touch ID معطل — مشكلة في الشاشة أو الحساس',
  'chk-screen-genuine':  'شاشة غير أصلية — جودة وألوان أقل',
  'chk-battery-genuine': 'بطارية غير أصلية — عمر أقصر وخطر انتفاخ',
};
const SECTIONS = {
  pre:          ['chk-imei-apple','chk-stolen','chk-serial-match'],
  icloud:       ['chk-activation-lock','chk-mdm','chk-reset'],
  parts:        ['chk-screen-genuine','chk-battery-genuine','chk-camera-genuine','chk-faceid-genuine'],
  battery:      ['chk-battery-health','chk-battery-throttle','chk-ios-latest','chk-battery-cycles'],
  screen:       ['chk-display-dead','chk-true-tone','chk-touch','chk-speaker','chk-brightness'],
  camera:       ['chk-cam-back','chk-cam-front','chk-flash','chk-cam-lens'],
  connectivity: ['chk-wifi','chk-cellular','chk-bluetooth','chk-gps'],
  physical:     ['chk-water','chk-body','chk-buttons','chk-charging-port','chk-gap'],
};

function toggleSection(btn) {
  const section = btn.closest('.ic-section');
  const body = section.querySelector('.ic-section-body');
  const open = section.classList.toggle('ic-section--open');
  btn.setAttribute('aria-expanded', String(open));
  body.hidden = !open;
}

function toggleTip(item) {
  item.classList.toggle('expanded');
}

function mark(evt, id, status) {
  evt.stopPropagation();
  const el = document.getElementById(id);
  el.classList.remove('ok','fail','skip');
  const bullet = el.querySelector('.ic-bullet');

  if (state[id] === status) {
    delete state[id];
    bullet.textContent = '';
  } else {
    state[id] = status;
    el.classList.add(status);
    bullet.textContent = status === 'ok' ? '✓' : status === 'fail' ? '✗' : '–';
  }
  refresh();
}

function refresh() {
  const ok    = Object.values(state).filter(v => v === 'ok').length;
  const fail  = Object.values(state).filter(v => v === 'fail').length;
  const skip  = Object.values(state).filter(v => v === 'skip').length;
  const checked = ok + fail + skip;

  // section progress
  for (const [key, ids] of Object.entries(SECTIONS)) {
    const done = ids.filter(id => state[id]).length;
    const el = document.getElementById(`prog-${key}`);
    if (el) el.textContent = `${done} / ${ids.length}`;
  }

  // summary
  document.getElementById('sumOk').textContent    = ok;
  document.getElementById('sumFail').textContent  = fail;
  document.getElementById('sumSkip').textContent  = skip;
  document.getElementById('sumPending').textContent = TOTAL - checked;

  // score
  const numEl   = document.getElementById('scoreNum');
  const ringEl  = document.getElementById('ringFill');
  const labelEl = document.getElementById('scoreLabel');
  const countEl = document.getElementById('scoreCount');
  const sepEl   = document.getElementById('scoreSep');
  const totEl   = document.getElementById('scoreTotal');

  if (checked === 0) {
    numEl.textContent = '—';
    ringEl.style.strokeDashoffset = '113';
    ringEl.className = 'ic-ring-fill';
    labelEl.textContent = 'لم تبدأ الفحص بعد';
    countEl.textContent = '';
    sepEl.style.display = 'none';
    totEl.style.display = 'none';
    document.getElementById('verdict').innerHTML = '';
    document.getElementById('warnings').innerHTML = '';
    return;
  }

  let score = 100;
  for (const [id, v] of Object.entries(state)) {
    if (v === 'fail') score -= CRITICAL[id] ? 20 : 8;
  }
  const unanswered = TOTAL - checked;
  score = Math.max(0, Math.min(100, score - Math.floor(unanswered * 0.4)));

  const circumference = 113;
  const offset = circumference - (score / 100) * circumference;
  ringEl.style.strokeDashoffset = String(offset);

  const cls = score >= 75 ? '' : score >= 50 ? 'warn' : 'danger';
  ringEl.className = `ic-ring-fill${cls ? ' ' + cls : ''}`;
  numEl.textContent = checked >= 5 ? String(score) : '—';

  sepEl.style.display = 'inline';
  totEl.style.display = 'inline';
  countEl.textContent = `${checked} فحص`;

  if (score >= 90)      labelEl.textContent = 'ممتاز — صفقة جيدة';
  else if (score >= 75) labelEl.textContent = 'جيد — مع ملاحظات';
  else if (score >= 55) labelEl.textContent = 'يحتاج تفاوض على السعر';
  else if (score >= 35) labelEl.textContent = 'مشاكل كثيرة — احذر';
  else                  labelEl.textContent = 'غير مناسب للشراء';

  // verdict
  if (checked >= 5) {
    const verdictEl = document.getElementById('verdict');
    const hasCritical = Object.entries(state).some(([id, v]) => v === 'fail' && CRITICAL[id]);
    let vcls, vicon, vtitle, vsub;
    if (hasCritical) {
      vcls = 'bad'; vicon = '🚨'; vtitle = 'لا توصي بالشراء';
      vsub = 'مشكلة حاسمة مكتشفة — راجع التحذيرات أدناه';
    } else if (fail >= 4) {
      vcls = 'bad'; vicon = '⛔'; vtitle = 'مشاكل متعددة — ابعد';
      vsub = `${fail} مشكلة مكتشفة — ليست صفقة جيدة`;
    } else if (fail >= 2) {
      vcls = 'caution'; vicon = '⚠️'; vtitle = 'تفاوض على السعر';
      vsub = `${fail} مشاكل — اطلب تخفيضاً في السعر`;
    } else if (fail === 1) {
      vcls = 'caution'; vicon = '🟡'; vtitle = 'مقبول مع تحفظ';
      vsub = 'مشكلة واحدة — ناقش مع البائع';
    } else {
      vcls = 'good'; vicon = '✅'; vtitle = 'يبدو جيداً — اشتري';
      vsub = 'لم تُكتشف مشاكل واضحة';
    }
    verdictEl.innerHTML = `<div class="ic-verdict-inner ic-verdict--${vcls}">
      <span class="ic-verdict-icon">${vicon}</span>
      <div class="ic-verdict-text"><strong>${vtitle}</strong><span>${vsub}</span></div>
    </div>`;
  }

  // warnings
  const warningsEl = document.getElementById('warnings');
  const fails = Object.entries(state).filter(([, v]) => v === 'fail');
  if (fails.length === 0) {
    warningsEl.innerHTML = '';
  } else {
    const items = fails.map(([id]) => {
      const el = document.getElementById(id);
      const strong = el.querySelector('.ic-item-text strong');
      return `<li>${strong ? strong.textContent : id}</li>`;
    }).join('');
    warningsEl.innerHTML = `<h3>مشاكل مكتشفة</h3><ul>${items}</ul>`;
  }
}

function resetAll() {
  if (!confirm('إعادة تعيين كل الإجابات؟')) return;
  for (const k of Object.keys(state)) delete state[k];
  document.querySelectorAll('.ic-item').forEach(el => {
    el.classList.remove('ok','fail','skip','expanded');
    const b = el.querySelector('.ic-bullet');
    if (b) b.textContent = '';
  });
  refresh();
}

function openImeiCheck() {
  const imei = document.getElementById('imeiInput').value.replace(/\s/g, '');
  if (imei.length >= 14) {
    window.open(`https://checkcoverage.apple.com/?sn=${imei}`, '_blank');
  } else {
    alert('أدخل رقم IMEI الكامل (14-15 رقم)');
  }
}
</script>
